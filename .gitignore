# ==========================================
# 1. Environment & Secrets Management
# ==========================================
# Block local environment files containing sensitive production credentials
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Allow committing template file to provide environment schema for developers
!.env.example

# ==========================================
# 2. Docker & Infrastructure Overrides
# ==========================================
# Prevent developer-specific infrastructure modifications from merging into master
docker-compose.override.yml

# ==========================================
# 3. Dependencies & Auto-generated Code
# ==========================================
# Exclude local heavy packages; dependencies must be resolved natively on the target host
node_modules/
.npm/

# Block localized Prisma Client builds to prevent massive codebase noise and OS engine conflicts
/src/generated/prisma/

# Exclude local TypeScript compilation targets; Docker handles clean distribution builds
dist/
build/

# Prevent logging artifacts and execution trace files from polluting repo history
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/

# ==========================================
# 4. OS Artifacts & IDE Configurations
# ==========================================
# Strip system-specific index caches and workspace metadata files
.DS_Store
.vscode/
.idea/
